# ===== OKX API 키 (OKX 웹 > 프로필 > API 에서 발급) =====
# 권한은 "읽기 + 거래"만 체크하세요. "출금" 권한은 절대 주지 마세요.
# 데모 트레이딩용 키는 OKX 웹의 "데모 트레이딩" 모드에서 별도로 발급해야 합니다.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# 1 = 데모(모의) 거래, 0 = 실거래. 충분히 검증하기 전까지 1로 두세요.
OKX_DEMO=1
# true = 주문을 아예 보내지 않고 로그만 남김 (시그널 확인용)
DRY_RUN=true

# ===== 전략 설정 =====
INST_ID=BTC-USDT
BAR=15m
EMA_FAST=9
EMA_SLOW=21

# ===== 리스크 관리 =====
# 1회 매수 금액 (USDT)
ORDER_USDT=20
# 손절 / 익절 비율 (%)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
# 루프 주기 (초)
POLL_SECONDS=30
